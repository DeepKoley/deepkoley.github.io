<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Page Header -->
  <header class="mb-16">
    {% set currentPage = "Projects" %}
    {% include "components/breadcrumbs.njk" %}
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs mb-3 shadow-xs">
      <i class="ph ph-stack text-sm text-primary"></i>
      <span id="typed-projects-page-header"></span>
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4">
      Featured Projects & Case Studies
    </h1>
    <p class="text-lg text-base-content/70 leading-relaxed max-w-4xl">
      A collection of end-to-end applications, developer infrastructure, and
      design systems I've designed and shipped.
    </p>
  </header>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {% for project in collections.projects | reverse %}
      {% include "components/project-card.njk" %}
    {% else %}
      <div class="col-span-full card bg-base-200 card-border p-12 sm:p-16 text-center border-dashed border-base-300/80">
        <div class="w-16 h-16 rounded-2xl bg-base-300/60 border border-base-300 flex items-center justify-center mx-auto mb-4 text-secondary">
          <i class="ph ph-stack text-4xl"></i>
