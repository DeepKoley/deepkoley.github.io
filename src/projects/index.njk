---
layout: base.njk
title: "Projects — Deep Koley"
description: "Explore selected full-stack web applications, open source tools, and digital experiences engineered by Deep Koley."
pagination:
  data: collections.projects
  size: 2
  alias: projects
  reverse: true
permalink: "projects/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
eleventyExcludeFromCollections: true

---

<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Page Header -->
  <header class="mb-16">
    <div class="breadcrumbs text-sm mb-4 text-base-content/60">
      <ul>
        <li><a href="/">Home</a></li>
        <li class="text-base-content">Projects</li>
      </ul>
    </div>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs mb-3 shadow-xs">
      <i data-feather="layers" class="w-3.5 h-3.5 text-primary"></i>
      <span id="typed-projects-page-header"></span>
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4">
      Featured Projects & Case Studies
    </h1>
    <p class="text-lg text-base-content/70 leading-relaxed max-w-4xl">
      A collection of end-to-end applications, developer infrastructure, and
      design systems I've designed and shipped.
    </p>
  </header>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {% for project in projects %}
      <article class="card bg-base-200 card-border overflow-hidden hover:-translate-y-1 hover:shadow-2xl transition-all duration-300 flex flex-col justify-between">
        <div>
          <!-- Project Image -->
          <a
            href="{{ project.url }}"
            class="block overflow-hidden aspect-video bg-base-300 relative group"
          >
            <img
              src="{{ project.data.image }}"
              alt="{{ project.data.title }}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {% if project.data.status %}
              <span
                class="absolute top-4 right-4 badge badge-success badge-soft font-mono text-xs shadow-md"
              >
                {{ project.data.status }}
              </span>
            {% endif %}
          </a>

          <!-- Project Body -->
          <div class="card-body p-6 sm:p-8">
            <div class="flex items-center gap-2 mb-2">
              <span
                class="text-xs font-mono text-primary uppercase tracking-wider font-semibold"
              >
                {{ project.data.category | default('Full-Stack') }}
              </span>
              <span class="text-xs text-base-content/40 font-mono">• {{
                  project.data.year | default('2026')
                }}</span>
            </div>

            <h2 class="card-title text-2xl font-headline hover:text-primary transition-colors">
              <a href="{{ project.url }}">
                {{ project.data.title }}
              </a>
            </h2>

            <p class="text-base-content/70 text-sm leading-relaxed mt-2 mb-6">
              {{ project.data.description }}
            </p>

            <!-- Tech Badges -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {% for tag in project.data.tags %}
                {% if tag != "projects" %}
                  <span class="badge badge-neutral badge-xs font-mono">{{
                    tag
                  }}</span>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

        <!-- Card Footer -->
        <div class="px-6 pb-6 pt-0 sm:px-8 sm:pb-8 flex items-center justify-between border-t border-base-300/50 mt-auto">
          <a href="{{ project.url }}" class="btn btn-sm btn-primary">
            View Case Study
            <i data-feather="arrow-right" class="w-3.5 h-3.5"></i>
          </a>
          {% if project.data.demoUrl %}
            <a
              href="{{ project.data.demoUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-ghost"
              title="Open live preview"
            >
              <i data-feather="external-link" class="w-4 h-4"></i>
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>

  <!-- Pagination Controls -->
  {% if pagination.pages.length > 1 %}
    <nav
      aria-label="Projects Pagination"
      class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-16 pt-8 border-t border-base-300"
    >
      <div class="text-xs sm:text-sm font-mono text-base-content/60">
        Page <span class="text-primary font-bold">{{
          pagination.pageNumber + 1
        }}</span> of <span class="text-base-content font-bold">{{
          pagination.pages.length
        }}</span> • <span class="text-base-content/50">{{
            collections.projects.length
          }} Projects Total</span>
      </div>

      <div class="join shadow-xs border border-base-300 bg-base-200/50">
        {# Prev Button #}
        {% if pagination.href.previous %}
          <a
            href="{{ pagination.href.previous }}"
            class="join-item btn btn-sm sm:btn-md font-mono"
            aria-label="Previous Page"
          >
            <i data-feather="chevron-left" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Prev</span>
          </a>
        {% else %}
          <button
            class="join-item btn btn-disabled btn-sm sm:btn-md font-mono"
            disabled
            aria-label="Previous Page (Disabled)"
          >
            <i data-feather="chevron-left" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Prev</span>
          </button>
        {% endif %}

        {# Page Number Buttons #}
        {% for pageEntry in pagination.pages %}
          {% set pageUrl = pagination.hrefs[loop.index0] %}
          <a
            href="{{ pageUrl }}"
            class="join-item btn btn-sm sm:btn-md font-mono {% if page.url == pageUrl %}btn-primary font-bold shadow-xs{% else %}btn-ghost{% endif %}"
            {% if page.url == pageUrl %}
              aria-current="page"
            {% endif %}
          >
            {{ loop.index }}
          </a>
        {% endfor %}

        {# Next Button #}
        {% if pagination.href.next %}
          <a
            href="{{ pagination.href.next }}"
            class="join-item btn btn-sm sm:btn-md font-mono"
            aria-label="Next Page"
          >
            <span class="hidden sm:inline">Next</span>
            <i data-feather="chevron-right" class="w-4 h-4"></i>
          </a>
        {% else %}
          <button
            class="join-item btn btn-disabled btn-sm sm:btn-md font-mono"
            disabled
            aria-label="Next Page (Disabled)"
          >
            <span class="hidden sm:inline">Next</span>
            <i data-feather="chevron-right" class="w-4 h-4"></i>
          </button>
        {% endif %}
      </div>
    </nav>
  {% endif %}
</div>
