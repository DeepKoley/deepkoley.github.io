---
layout: base.njk
title: "Projects — Deep Koley"
description: "Explore selected full-stack web applications, open source tools, and digital experiences engineered by Deep Koley."
permalink: "projects/index.html"
eleventyExcludeFromCollections: true
---

<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Page Header -->
  <header class="mb-16">
    <div class="breadcrumbs text-sm mb-4 text-base-content/60">
      <ul>
        <li><a href="/">Home</a></li>
        <li class="text-base-content">Projects</li>
      </ul>
    </div>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs mb-3 shadow-xs">
      <i class="ph ph-stack text-sm text-primary"></i>
      <span id="typed-projects-page-header"></span>
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4">
      Featured Projects & Case Studies
    </h1>
    <p class="text-lg text-base-content/70 leading-relaxed max-w-4xl">
      A collection of end-to-end applications, developer infrastructure, and
      design systems I've designed and shipped.
    </p>
  </header>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {% for project in collections.projects | reverse %}
      <article class="card bg-base-200 card-border overflow-hidden flex flex-col justify-between group">
        <div>
          <!-- Project Image -->
          {% if project.data.image %}
            <a
              href="{{ project.url }}"
              class="block overflow-hidden aspect-video bg-base-300 relative"
            >
              <img
                src="{{ project.data.image }}"
                alt="{{ project.data.title }}"
                class="w-full h-full object-cover"
                loading="lazy"
              />
              {% if project.data.status %}
                <span
                  class="absolute top-4 right-4 badge badge-sm font-mono bg-base-100/80 backdrop-blur-md border border-white/10 text-emerald-400 shadow-md"
                >
                  {{ project.data.status }}
                </span>
              {% endif %}
            </a>
          {% endif %}

          <!-- Project Body -->
          <div class="card-body p-6 sm:p-8">
            <div class="flex items-center gap-2 mb-2">
              <span
                class="text-xs font-mono text-secondary uppercase tracking-wider font-semibold"
              >
                {{ project.data.category | default('Full-Stack') }}
              </span>
              <span class="text-xs text-base-content/40 font-mono">• {{
                  project.data.year | default('2026')
                }}</span>
            </div>

            <h2 class="card-title text-2xl font-headline group-hover:text-primary transition-colors">
              <a href="{{ project.url }}">
                {{ project.data.title }}
              </a>
            </h2>

            <p class="text-base-content/70 text-sm leading-relaxed mt-2 mb-6">
              {{ project.data.description }}
            </p>

            <!-- Tech Badges -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {% for tag in project.data.tags %}
                {% if tag != "projects" %}
                  <span class="badge badge-neutral badge-xs font-mono border border-base-300/60">{{
                    tag
                  }}</span>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

        <!-- Card Footer -->
        <div class="px-6 pb-6 pt-0 sm:px-8 sm:pb-8 flex items-center justify-between border-t border-base-300/50 mt-auto">
          <a href="{{ project.url }}" class="btn btn-sm btn-primary">
            View Case Study
            <i class="ph ph-arrow-right text-xs"></i>
          </a>
          {% if project.data.demoUrl %}
            <a
              href="{{ project.data.demoUrl }}"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-sm btn-ghost"
              title="Open live preview"
            >
              <i class="ph ph-arrow-square-out text-base"></i>
            </a>
          {% endif %}
        </div>
      </article>
    {% else %}
      <div class="col-span-full card bg-base-200 card-border p-12 sm:p-16 text-center border-dashed border-base-300/80">
        <div class="w-16 h-16 rounded-2xl bg-base-300/60 border border-base-300 flex items-center justify-center mx-auto mb-4 text-secondary">
          <i class="ph ph-stack text-4xl"></i>
        </div>
        <h3 class="font-headline text-2xl sm:text-3xl mb-2 text-base-content">No Projects Added Yet</h3>
        <p class="text-sm sm:text-base text-base-content/70 max-w-md mx-auto mb-6">
          Case studies, open-source repositories, and web apps will appear here once added to <code class="font-mono text-cyan-400 text-xs bg-base-300/60 px-1.5 py-0.5 rounded">src/projects/*.md</code>.
        </p>
        <div>
          <a href="/" class="btn btn-primary btn-sm font-mono inline-flex items-center gap-2">
            <i class="ph ph-arrow-left text-base"></i> Back to Home
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
