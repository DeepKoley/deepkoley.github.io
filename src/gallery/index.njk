---
layout: base.njk
title: "Visual Gallery & Photography — Deep Koley"
description: "A curated collection of visual moments, street scenes, architecture, and nature captured through the lens."
permalink: "gallery/index.html"
eleventyExcludeFromCollections: true
---

<link rel="stylesheet" href="/css/glightbox.min.css" />

<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Breadcrumb -->
  <div class="breadcrumbs text-sm mb-6 text-base-content/60">
    <ul>
      <li><a href="/">Home</a></li>
      <li class="text-base-content">Gallery</li>
    </ul>
  </div>

  <!-- Page Header -->
  <header class="mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs mb-3 shadow-xs">
      <i data-feather="camera" class="w-3.5 h-3.5 text-secondary"></i>
      <span id="typed-gallery-header">{{ gallery.pageBadge | default('visuals.raw') }}</span>
    </div>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4 leading-tight">
          {{ gallery.pageTitle | default('Visual Journal & Photography') }}
        </h1>
        <p class="text-lg text-base-content/70 leading-relaxed max-w-3xl">
          {{ gallery.pageDescription | default('A curated collection of streetscapes, architecture, and fleeting moments through the lens. Click any frame to inspect high-resolution details in the lightbox.') }}
        </p>
      </div>
      <div class="shrink-0 font-mono text-xs text-base-content/60 self-start md:self-end">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-base-200/80 border border-base-300">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span id="gallery-count-badge">{{ gallery.photos.length | default(0) }} frames</span>
        </span>
      </div>
    </div>
  </header>

  <!-- Category Filter Bar -->
  <div class="flex flex-wrap items-center gap-2 mb-10 pb-4 border-b border-base-300/60 font-mono text-xs">
    <span class="text-base-content/50 uppercase tracking-wider mr-2 hidden sm:inline-flex items-center gap-1.5">
      <i data-feather="sliders" class="w-3.5 h-3.5"></i> Filter:
    </span>
    <button
      type="button"
      data-filter="all"
      class="gallery-filter-btn px-4 py-2 rounded-xl border border-primary bg-primary text-primary-content font-medium transition-all shadow-xs"
    >
      All Frames
    </button>
    {% for cat in gallery.categories %}
      {% if cat != "All" %}
        <button
          type="button"
          data-filter="{{ cat | lower }}"
          class="gallery-filter-btn px-4 py-2 rounded-xl border border-base-300 bg-base-200/80 text-base-content/80 hover:text-white hover:border-white/20 transition-all shadow-xs"
        >
          {{ cat }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

  <!-- Masonry Photo Grid -->
  {% if gallery.photos and gallery.photos.length > 0 %}
    <div id="gallery-grid" class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
      {% for photo in gallery.photos %}
        <div
          class="gallery-item break-inside-avoid"
          data-category="{{ photo.category | lower }}"
        >
          <div class="card bg-base-200 card-border overflow-hidden group">
            <a
              href="{{ photo.image }}"
              class="glightbox block relative overflow-hidden cursor-zoom-in group/img"
              data-gallery="portfolio-gallery"
              data-title="{{ photo.title }}"
              data-description="{% if photo.caption %}{{ photo.caption }}<br><br>{% endif %}<span class='text-xs opacity-75'>📍 {{ photo.location | default('Undisclosed') }} &nbsp;•&nbsp; 📷 {{ photo.camera | default('Mirrorless') }} &nbsp;•&nbsp; 🗓 {{ photo.date }}</span>"
            >
              <img
                src="{{ photo.image }}"
                alt="{{ photo.title }}"
                class="w-full h-auto object-cover group-hover/img:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
              <!-- Ambient Hover Sheen & Details -->
              <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/30 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5">
                <div class="flex items-end justify-between gap-3">
                  <div>
                    {% if photo.category %}
                      <span class="text-[11px] font-mono text-cyan-400 font-semibold uppercase tracking-wider block mb-1">
                        {{ photo.category }}
                      </span>
                    {% endif %}
                    <h3 class="font-headline text-xl text-white leading-tight">
                      {{ photo.title }}
                    </h3>
                    {% if photo.location %}
                      <p class="text-xs text-white/80 font-mono mt-1.5 flex items-center gap-1.5">
                        <i data-feather="map-pin" class="w-3 h-3 text-primary shrink-0"></i>
                        {{ photo.location }}
                      </p>
                    {% endif %}
                  </div>
                  <div class="w-9 h-9 rounded-full bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center text-white shrink-0 group-hover/img:scale-110 transition-transform shadow-lg">
                    <i data-feather="maximize-2" class="w-4 h-4"></i>
                  </div>
                </div>
              </div>
            </a>

            <!-- Card Bottom Specs Bar -->
            <div class="px-4 py-3 border-t border-base-300/40 flex items-center justify-between text-xs font-mono text-base-content/60 bg-base-200/50">
              <span class="flex items-center gap-1">
                <i data-feather="calendar" class="w-3 h-3 text-base-content/40"></i>
                {{ photo.date }}
              </span>
              {% if photo.camera %}
                <span class="truncate max-w-[170px] text-right text-base-content/70" title="{{ photo.camera }}">
                  {{ photo.camera }}
                </span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Empty Filter Notice (Dynamic via JS) -->
    <div id="gallery-empty-filter" class="hidden card bg-base-200 card-border p-12 text-center border-dashed border-base-300/80">
      <div class="w-14 h-14 rounded-2xl bg-base-300/60 border border-base-300 flex items-center justify-center mx-auto mb-4 text-secondary">
        <i data-feather="image" class="w-6 h-6"></i>
      </div>
      <h3 class="font-headline text-2xl mb-1 text-base-content">No Frames in this Category</h3>
      <p class="text-sm font-mono text-base-content/60 max-w-sm mx-auto mb-4">
        Try selecting a different filter category or reset to view all photos.
      </p>
      <button type="button" onclick="document.querySelector('[data-filter=\"all\"]').click()" class="btn btn-primary btn-sm font-mono">
        Show All Frames
      </button>
    </div>

  {% else %}
    <!-- Global Empty State if No Photos Exist Yet -->
    <div class="card bg-base-200 card-border p-12 sm:p-16 text-center border-dashed border-base-300/80">
      <div class="w-16 h-16 rounded-2xl bg-base-300/60 border border-base-300 flex items-center justify-center mx-auto mb-4 text-primary">
        <i data-feather="camera" class="w-8 h-8"></i>
      </div>
      <h3 class="font-headline text-2xl sm:text-3xl mb-2 text-base-content">No Photos Uploaded Yet</h3>
      <p class="text-sm sm:text-base text-base-content/70 max-w-md mx-auto mb-6">
        Upload photos, camera specs, and captions via Pages CMS admin (<code class="font-mono text-cyan-400 text-xs bg-base-300/60 px-1.5 py-0.5 rounded">src/_data/gallery.json</code>) to populate your visual journal.
      </p>
      <div>
        <a href="/" class="btn btn-primary btn-sm font-mono inline-flex items-center gap-2">
          <i data-feather="arrow-left" class="w-4 h-4"></i> Back to Home
        </a>
      </div>
    </div>
  {% endif %}
</div>

<!-- GLightbox Script & Gallery Controller -->
<script src="/js/glightbox.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Initialize Feather Icons for newly rendered elements
    if (typeof feather !== 'undefined') {
      feather.replace();
    }

    // 2. Initialize GLightbox with custom effects
    let lightbox = null;
    const initLightbox = () => {
      if (typeof GLightbox === 'function') {
        if (lightbox && typeof lightbox.destroy === 'function') {
          lightbox.destroy();
        }
        lightbox = GLightbox({
          selector: '.gallery-item:not(.is-hidden) .glightbox',
          touchNavigation: true,
          loop: true,
          zoomable: true,
          draggable: true,
          openEffect: 'zoom',
          closeEffect: 'zoom',
          slideEffect: 'slide',
          moreText: 'See more',
          moreLength: 70,
        });
      }
    };

    initLightbox();

    // 3. Category Filter Tabs Controller
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');
    const emptyNotice = document.getElementById('gallery-empty-filter');
    const countBadge = document.getElementById('gallery-count-badge');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update button active states
        filterBtns.forEach((b) => {
          b.classList.remove('border-primary', 'bg-primary', 'text-primary-content', 'font-medium');
          b.classList.add('border-base-300', 'bg-base-200/80', 'text-base-content/80');
        });
        btn.classList.remove('border-base-300', 'bg-base-200/80', 'text-base-content/80');
        btn.classList.add('border-primary', 'bg-primary', 'text-primary-content', 'font-medium');

        // Filter items
        let visibleCount = 0;
        galleryItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (filter === 'all' || itemCat === filter) {
            item.classList.remove('is-hidden');
            item.style.opacity = '1';
            item.style.transform = 'scale(1)';
            visibleCount++;
          } else {
            item.classList.add('is-hidden');
            item.style.opacity = '0';
            item.style.transform = 'scale(0.96)';
          }
        });

        // Toggle empty notice
        if (emptyNotice) {
          if (visibleCount === 0) {
            emptyNotice.classList.remove('hidden');
          } else {
            emptyNotice.classList.add('hidden');
          }
        }

        // Update count badge
        if (countBadge) {
          countBadge.textContent = `${visibleCount} ${visibleCount === 1 ? 'frame' : 'frames'}`;
        }

        // Re-initialize lightbox with filtered subset
        initLightbox();

        // Refresh icons if needed
        if (typeof feather !== 'undefined') {
          feather.replace();
        }
      });
    });
  });
</script>

