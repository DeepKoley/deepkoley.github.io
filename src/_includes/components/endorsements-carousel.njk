<div class="relative max-w-4xl mx-auto" id="endorsements-carousel-container">
  <!-- Carousel Track with Scroll Snap -->
  <div
    id="endorsements-track"
    class="flex overflow-x-auto scroll-smooth snap-x snap-mandatory gap-6 py-4"
    style="scrollbar-width: none; -ms-overflow-style: none;"
    role="region"
    aria-label="Endorsements Carousel"
  >
    {% for item in home.testimonials %}
      <div
        class="endorsements-slide w-full shrink-0 snap-center"
        data-index="{{ loop.index0 }}"
      >
        <div class="card bg-base-200 card-border p-8 sm:p-10 md:p-12 rounded-3xl relative overflow-hidden flex flex-col justify-between shadow-xl hover:border-white/10 transition-colors duration-200 min-h-[280px]">
          <!-- Background decorative watermark quote -->
          <i class="ph ph-quotes absolute -bottom-6 -right-6 text-9xl text-base-300/20 pointer-events-none select-none" aria-hidden="true"></i>

          <div>
            <!-- Top badge & quote icon -->
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-2xl bg-base-300/70 border border-base-300 flex items-center justify-center text-primary shadow-xs">
                <i class="ph ph-quotes text-2xl"></i>
              </div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-mono text-primary font-medium">
                <i class="ph ph-check-circle text-xs"></i>
                <span>Endorsement</span>
              </span>
            </div>

            <!-- Quote Text -->
            <p class="text-base sm:text-lg md:text-xl font-headline tracking-tight text-base-content/95 leading-relaxed mb-8">
              "{{ item.quote }}"
            </p>
          </div>

          <!-- Bottom Author Attribution -->
          <div class="pt-6 border-t border-base-300/60 flex items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="avatar shrink-0">
                <div class="w-12 sm:w-14 h-12 sm:h-14 rounded-full ring-2 ring-primary/40 ring-offset-2 ring-offset-base-200 overflow-hidden bg-base-300 shadow-md">
                  <img
                    src="{{ item.avatar }}"
                    alt="{{ item.author }}"
                    loading="lazy"
                    class="w-full h-full object-cover"
                    onerror="this.src='https://ui-avatars.com/api/?name={{ item.author | urlencode }}&background=18181b&color=38bdf8';"
                  />
                </div>
              </div>
              <div class="min-w-0">
                <div class="font-headline text-lg sm:text-xl text-base-content tracking-tight truncate">{{ item.author }}</div>
                <div class="text-xs sm:text-sm font-mono text-base-content/60 mt-0.5 truncate">
                  {{ item.role }} • <span class="text-primary font-medium">{{ item.company }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- Carousel Controls Bar (Prev/Next buttons, Dots, Counter) -->
  <div class="flex items-center justify-between mt-6 px-2">
    <!-- Slide Counter -->
    <div class="font-mono text-xs text-base-content/60">
      <span id="endorsements-current-num" class="text-primary font-bold">01</span>
      <span>/</span>
      <span id="endorsements-total-num">0{{ home.testimonials.length }}</span>
    </div>

    <!-- Indicator Dots -->
    <div class="flex items-center gap-2" id="endorsements-dots">
      {% for item in home.testimonials %}
        <button
          type="button"
          class="endorsements-dot w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer {% if loop.first %}bg-primary w-8{% else %}bg-base-content/20 hover:bg-base-content/40{% endif %}"
          data-slide-to="{{ loop.index0 }}"
          aria-label="Go to endorsement {{ loop.index }}"
        ></button>
      {% endfor %}
    </div>

    <!-- Arrow Buttons -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="endorsements-prev-btn"
        class="w-10 h-10 rounded-xl bg-base-200 hover:bg-base-300 border border-base-300 hover:border-white/10 flex items-center justify-center text-base-content/70 hover:text-base-content transition-colors duration-200 cursor-pointer shadow-xs"
        aria-label="Previous endorsement"
      >
        <i class="ph ph-arrow-left text-base"></i>
      </button>
      <button
        type="button"
        id="endorsements-next-btn"
        class="w-10 h-10 rounded-xl bg-base-200 hover:bg-base-300 border border-base-300 hover:border-white/10 flex items-center justify-center text-base-content/70 hover:text-base-content transition-colors duration-200 cursor-pointer shadow-xs"
        aria-label="Next endorsement"
      >
        <i class="ph ph-arrow-right text-base"></i>
      </button>
    </div>
  </div>
</div>
