<article class="card bg-base-200 card-border p-6 flex flex-col justify-between hover:border-white/10 transition-colors duration-200 rounded-2xl">
  <!-- Top Row: Avatar + Name + Role -->
  <div>
    <div class="flex items-start gap-4 mb-4">
      <div class="avatar shrink-0">
        <div class="w-12 h-12 rounded-full ring-1 ring-base-300 ring-offset-base-200 ring-offset-2 overflow-hidden bg-base-300">
          <img
            src="{{ friend.avatar }}"
            alt="{{ friend.name }}"
            loading="lazy"
            class="w-full h-full object-cover"
            onerror="this.src =
  'https://ui-avatars.com/api/?name={{ friend.name | urlencode }}&background=18181b&color=38bdf8'"
          />
        </div>
      </div>
      <div class="min-w-0 flex-1">
        <h2 class="text-lg font-bold font-headline tracking-tight text-base-content truncate">
          {{ friend.name }}
        </h2>
        <p class="text-xs font-mono text-primary truncate mt-0.5">
          {{ friend.role }}
        </p>
      </div>
    </div>

    <!-- Bio -->
    <p class="text-sm text-base-content/70 leading-relaxed mb-5">
      {{ friend.bio }}
    </p>
  </div>

  <!-- Bottom: Tags & Action Link -->
  <div class="space-y-4 pt-2 border-t border-base-300/60">
    {% if friend.tags and friend.tags.length > 0 %}
      <div class="flex flex-wrap gap-1.5">
        {% for tag in friend.tags %}
          <span
            class="badge badge-neutral badge-xs font-mono border border-base-300/60"
          >
            {{ tag }}
          </span>
        {% endfor %}
      </div>
    {% endif %}

    <a
      href="{{ friend.url }}"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-base-300/40 hover:bg-base-300 border border-base-300 hover:border-white/15 text-xs font-mono text-base-content/80 hover:text-base-content transition-colors duration-200 group/btn"
    >
      <span class="flex items-center gap-2 font-medium truncate">
        <i
          class="ph ph-globe text-primary text-sm group-hover/btn:rotate-12 transition-transform"
        ></i>
        <span class="truncate">{{
          friend.url | replace("https://", "") | replace("http://", "") | replace("www.", "")
        }}</span>
      </span>
      <span
        class="w-6 h-6 rounded-lg bg-base-200 flex items-center justify-center text-base-content/50 group-hover/btn:text-base-content transition-colors shrink-0"
      >
        <i class="ph ph-arrow-up-right text-xs"></i>
      </span>
    </a>
  </div>
</article>
