        {{ site.firstName }} <span class="text-primary">{{
          site.lastName
        }}</span>
      </a>
    </div>
    <div class="navbar-end hidden lg:flex">
      <ul class="menu menu-horizontal px-1 gap-1">
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About</a></li>
