{% if site.socialLinks and site.socialLinks.length > 0 %}
  <div class="flex flex-wrap items-center justify-center gap-3">
    {% for social in site.socialLinks %}
      <a
        href="{{ social.url }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ social.name }}"
        class="w-9 h-9 rounded-xl bg-base-300/40 hover:bg-base-300 border border-base-300 hover:border-white/15 flex items-center justify-center text-base-content/70 hover:text-primary transition-all duration-200 shadow-xs group"
        title="{{ social.name }}"
      >
        <i class="ph {{ social | socialIcon }} text-lg group-hover:scale-110 transition-transform"></i>
      </a>
    {% endfor %}
  </div>
{% endif %}
