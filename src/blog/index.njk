---
layout: base.njk
title: "Blog & Articles — Deep Koley"
description: "Insights, deep-dives, and tutorials on modern web development, performance optimization, and software architecture by Deep Koley."
permalink: "blog/index.html"
eleventyExcludeFromCollections: true
---

<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Page Header -->
  <header class="mb-16">
    <div class="breadcrumbs text-sm mb-4 text-base-content/60">
      <ul>
        <li><a href="/">Home</a></li>
        <li class="text-base-content">Blog</li>
      </ul>
    </div>
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs mb-3 shadow-xs">
      <i data-feather="book-open" class="w-3.5 h-3.5 text-secondary"></i>
      <span id="typed-blog-page-header"></span>
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4">
      Articles & Engineering Notes
    </h1>
    <p class="text-lg text-base-content/70 leading-relaxed max-w-4xl">
      A collection of deep dives into modern web platforms, component design
      systems, and lessons learned building scalable software.
    </p>
  </header>

  <!-- Blog Posts Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for post in collections.posts | reverse %}
      <article class="card bg-base-200 card-border overflow-hidden flex flex-col justify-between group">
        <div>
          <!-- Post Image -->
          {% if post.data.image %}
            <a
              href="{{ post.url }}"
              class="block overflow-hidden aspect-video bg-base-300 relative"
            >
              <img
                src="{{ post.data.image }}"
                alt="{{ post.data.title }}"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </a>
          {% endif %}

          <!-- Post Content -->
          <div class="card-body p-6">
            <div class="flex items-center gap-2 mb-2 text-xs font-mono text-base-content/60">
              <time datetime="{{ post.date }}">{{
                post.date | readableDate
              }}</time>
              {% if post.data.readTime %}
                <span>• {{ post.data.readTime }}</span>
              {% endif %}
            </div>

            <h2 class="card-title text-xl font-headline leading-snug group-hover:text-primary transition-colors">
              <a href="{{ post.url }}">
                {{ post.data.title }}
              </a>
            </h2>

            <p class="text-base-content/70 text-sm leading-relaxed mt-2 mb-4">
              {{ post.data.description }}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1 mt-auto">
              {% for tag in post.data.tags %}
                {% if tag != "posts" %}
                  <span
                    class="badge badge-neutral badge-xs font-mono border border-base-300/60"
                  >{{ tag }}</span>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>

        <!-- Card Footer -->
        <div class="px-6 pb-6 pt-0 border-t border-base-300/40 mt-4 flex items-center justify-between">
          <a
            href="{{ post.url }}"
            class="link link-primary text-sm font-mono inline-flex items-center gap-1.5 pt-4"
          >
            Read Article
            <i data-feather="arrow-right" class="w-3.5 h-3.5"></i>
          </a>
        </div>
      </article>
    {% else %}
      <div class="col-span-full card bg-base-200 card-border p-12 sm:p-16 text-center border-dashed border-base-300/80">
        <div class="w-16 h-16 rounded-2xl bg-base-300/60 border border-base-300 flex items-center justify-center mx-auto mb-4 text-primary">
          <i data-feather="book-open" class="w-8 h-8"></i>
        </div>
        <h3 class="font-headline text-2xl sm:text-3xl mb-2 text-base-content">No Articles Published Yet</h3>
        <p class="text-sm sm:text-base text-base-content/70 max-w-md mx-auto mb-6">
          Engineering logs, tutorials, and architecture breakdowns will appear here once added to <code class="font-mono text-cyan-400 text-xs bg-base-300/60 px-1.5 py-0.5 rounded">src/blog/*.md</code>.
        </p>
        <div>
          <a href="/" class="btn btn-primary btn-sm font-mono inline-flex items-center gap-2">
            <i data-feather="arrow-left" class="w-4 h-4"></i> Back to Home
          </a>
        </div>
      </div>
    {% endfor %}
  </div>
</div>
