---
layout: base.njk
title: "Resume — Deep Koley"
description: "Curriculum Vitae and professional experience of Deep Koley, Full-Stack Developer specializing in scalable web systems and modern architectures."
eleventyExcludeFromCollections: true

---

{%
  set hasResumeData = (resume.experience and resume.experience.length > 0) or (resume.competencies and resume.competencies.length > 0) or (resume.education and resume.education.length > 0) or (resume.summary and resume.summary | trim | length > 0)
%}

<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Breadcrumb -->
  {% set currentPage = "Resume" %}
  {% include "components/breadcrumbs.njk" %}

  <!-- Page Header -->
  <header class="mb-14">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs shadow-xs">
        <i class="ph ph-file-text text-sm text-primary"></i>
        <span>{{ resume.pageBadge | default('curriculum_vitae.pdf') }}</span>
      </div>
      {% if hasResumeData %}
        <div class="flex items-center gap-3">
          <button
            onclick="window.print()"
            class="btn btn-outline btn-sm font-mono gap-2"
          >
            <i class="ph ph-printer text-base"></i>
            Print / PDF
          </button>
          <a
            href="/cv.pdf"
            download
            class="btn btn-primary btn-sm font-mono gap-2"
          >
            <i class="ph ph-download-simple text-base"></i>
            Download CV
          </a>
        </div>
      {% endif %}
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4 leading-tight">
      {{ resume.pageTitle | default('Professional Resume') }}
    </h1>
    <p class="text-lg text-base-content/70 leading-relaxed max-w-3xl">
      {{ resume.pageDescription | default('A detailed record of full-stack engineering roles, technical proficiencies, architectural achievements, and education.') }}
    </p>
  </header>

  {% if hasResumeData %}
    <!-- Resume Sheet (Card Container) -->
    <div class="card bg-base-200 card-border rounded-2xl shadow-2xl p-6 sm:p-10 lg:p-12 space-y-12">
      <!-- Header Block inside Resume -->
      <div class="flex flex-col md:flex-row md:items-center justify-between pb-8 border-b border-base-300 gap-6">
        <div>
          <h2 class="text-3xl sm:text-4xl font-headline tracking-tight">
            {{ site.name }}
          </h2>
          <p class="text-primary font-mono text-base font-semibold mt-1">
            {{ resume.title or site.title }}
          </p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs font-mono">
          {% if site.location %}
            <span
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-base-100 border border-base-300 text-base-content/80"
            >
              <i class="ph ph-map-pin text-sm text-base-content/60"></i>
              {{ site.location }}
            </span>
          {% endif %}
          {% if site.email %}
            <a
              href="mailto:{{ site.email }}"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-base-100 border border-base-300 link link-hover text-base-content hover:text-primary group"
            >
              <i
                class="ph ph-envelope text-sm text-base-content/60 group-hover:text-primary transition-colors"
              ></i>
              {{ site.email }}
            </a>
          {% endif %}
          {% for social in site.socialLinks %}
            <a
              href="{{ social.url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-base-100 border border-base-300 link link-hover text-base-content hover:text-primary group"
            >
              <i
                class="ph {{ social | socialIcon }} text-sm text-base-content/60 group-hover:text-primary transition-colors"
              ></i>
              {{ social.name }}
            </a>
          {% endfor %}
        </div>
      </div>

      <!-- Executive Summary -->
      {% if resume.summary and resume.summary | trim | length > 0 %}
        <section>
          <h3 class="text-xs uppercase tracking-widest text-base-content/50 font-mono font-semibold mb-3">
            Executive Summary
          </h3>
          <p class="text-base text-base-content/80 leading-relaxed max-w-4xl">
            {{ resume.summary }}
          </p>
        </section>
      {% endif %}

      <!-- Professional Experience -->
      {% if resume.experience and resume.experience.length > 0 %}
        <section class="space-y-6">
          <h3 class="text-xs uppercase tracking-widest text-base-content/50 font-mono font-semibold mb-6">
            Experience
          </h3>
          <div class="space-y-8">
            {% for job in resume.experience %}
              <div class="relative pl-6 border-l-2 {% if job.isCurrent %}border-primary/30{% else %}border-base-300{% endif %} space-y-3">
                <div class="absolute -left-2.25 top-1.5 w-4 h-4 rounded-full bg-base-100 border-2 {% if job.isCurrent %}border-primary{% else %}border-base-300{% endif %}">
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                  <h4 class="text-xl font-headline text-base-content">
                    {{ job.role }} <span
                      class="text-base-content/50 font-normal"
                    >@ {{ job.company }}</span>
                  </h4>
                  <span
                    class="text-xs font-mono {% if job.isCurrent %}text-primary font-semibold bg-primary/10{% else %}text-base-content/60 bg-base-300/50{% endif %} px-2.5 py-0.5 rounded-md self-start sm:self-auto"
                  >{{ job.period }}</span>
                </div>
                <p class="text-sm text-base-content/70">
                  {{ job.location }} • {{ job.subtitle }}
                </p>
                <ul class="list-disc list-outside pl-4 space-y-2 text-sm text-base-content/80 leading-relaxed">
                  {% for item in job.highlights %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
                <div class="flex flex-wrap gap-1.5 pt-1">
                  {% for skill in job.skills %}
                    <span
                      class="badge badge-neutral text-xs font-mono border border-base-300/60"
                    >{{ skill }}</span>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      <!-- Technical Skills Matrix -->
      {% if resume.competencies and resume.competencies.length > 0 %}
        <section class="space-y-6">
          <h3 class="text-xs uppercase tracking-widest text-base-content/50 font-mono font-semibold mb-6">
            Skills &amp; Competencies
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {% for comp in resume.competencies %}
              <div class="p-5 rounded-2xl bg-base-100 border border-base-300">
                <h4 class="font-headline text-lg mb-2 text-base-content">
                  {{ comp.title }}
                </h4>
                <p class="text-xs font-mono text-{{ comp.color | default('primary') }} mb-3">
                  {{ comp.subtitle }}
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {% for skill in comp.skills %}
                    <span
                      class="badge badge-neutral text-xs font-mono border border-base-300/60"
                    >{{ skill }}</span>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}

      <!-- Education -->
      {% if resume.education and resume.education.length > 0 %}
        <section class="border-t border-base-300 pt-8 space-y-6">
          <h3 class="text-xs uppercase tracking-widest text-base-content/50 font-mono font-semibold mb-6">
            Education
          </h3>
          <div class="space-y-4">
            {% for edu in resume.education %}
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-4">
                <div>
                  <h4 class="text-lg font-headline text-base-content">
                    {{ edu.degree }}
                  </h4>
                  <p class="text-sm text-base-content/70">
                    {{ edu.institution }}
                  </p>
                </div>
                <span
                  class="text-xs font-mono text-base-content/60 self-start sm:self-auto"
                >{{ edu.period }}</span>
              </div>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </div>
  {% else %}
    <!-- Placeholder When Resume Data Is Empty -->
    <div class="card bg-base-200 card-border p-12 sm:p-16 text-center border-dashed border-base-300/80 rounded-2xl shadow-xl">
      <div class="w-16 h-16 rounded-2xl bg-base-300/60 border border-base-300 flex items-center justify-center mx-auto mb-4 text-primary">
        <i class="ph ph-file-text text-4xl"></i>
      </div>
      <h2 class="font-headline text-3xl sm:text-4xl mb-3 text-base-content">
        Resume Will Be Added Soon
      </h2>
      <p class="text-base text-base-content/70 max-w-md mx-auto mb-8 leading-relaxed">
        Curriculum vitae, verified work experience, technical competencies, and
        education records will be published here soon.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="btn btn-primary btn-sm font-mono inline-flex items-center gap-2"
        >
          <i class="ph ph-arrow-left text-base"></i> Back to Home
        </a>
        <a
          href="/projects/"
          class="btn btn-outline btn-sm font-mono inline-flex items-center gap-2"
        >
          Explore Projects <i class="ph ph-arrow-right text-base"></i>
        </a>
      </div>
    </div>
  {% endif %}
</div>
