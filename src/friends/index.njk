---
layout: base.njk
title: "Friends & Blogroll — Deep Koley"
description: "A curated directory celebrating friends, collaborators, and independent creators across the open web."
permalink: "friends/index.html"
eleventyExcludeFromCollections: true
---

<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Breadcrumb -->
  <div class="breadcrumbs text-sm mb-6 text-base-content/60">
    <ul>
      <li><a href="/">Home</a></li>
      <li class="text-base-content">Friends</li>
    </ul>
  </div>

  <!-- Page Header -->
  <header class="mb-14">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs mb-3 shadow-xs">
      <i class="ph ph-users text-sm text-primary"></i>
      <span>{{ friends.pageBadge | default('Community & Webring') }}</span>
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4 leading-tight">
      {{ friends.pageTitle | default('Friends & Blogroll') }}
    </h1>
    <p class="text-lg text-base-content/70 leading-relaxed max-w-3xl">
      {{ friends.pageDescription | default('A curated directory celebrating friends, collaborators, and independent creators across the open web.') }}
    </p>
  </header>

  <!-- Friends Directory Grid -->
  {% if friends.friends and friends.friends.length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {% for friend in friends.friends %}
        <article class="card bg-base-200 card-border p-6 flex flex-col justify-between hover:border-white/10 transition-colors duration-200 rounded-2xl">
          <!-- Top Row: Avatar + Name + Role -->
          <div>
            <div class="flex items-start gap-4 mb-4">
              <div class="avatar shrink-0">
                <div class="w-12 h-12 rounded-full ring-1 ring-base-300 ring-offset-base-200 ring-offset-2 overflow-hidden bg-base-300">
                  <img
                    src="{{ friend.avatar }}"
                    alt="{{ friend.name }}"
                    loading="lazy"
                    class="w-full h-full object-cover"
                    onerror="this.src='https://ui-avatars.com/api/?name={{ friend.name | urlencode }}&background=18181b&color=38bdf8';"
                  />
                </div>
              </div>
              <div class="min-w-0 flex-1">
                <h2 class="text-lg font-bold font-headline tracking-tight text-base-content truncate">
                  {{ friend.name }}
                </h2>
                <p class="text-xs font-mono text-primary truncate mt-0.5">
                  {{ friend.role }}
                </p>
              </div>
            </div>

            <!-- Bio -->
            <p class="text-sm text-base-content/70 leading-relaxed mb-5">
              {{ friend.bio }}
            </p>
          </div>

          <!-- Bottom: Tags & Action Link -->
          <div class="space-y-4 pt-2 border-t border-base-300/60">
            {% if friend.tags and friend.tags.length > 0 %}
              <div class="flex flex-wrap gap-1.5">
                {% for tag in friend.tags %}
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-base-300/60 text-base-content/70 border border-base-300/40">
                    {{ tag }}
                  </span>
                {% endfor %}
              </div>
            {% endif %}

            <a
              href="{{ friend.url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-between w-full px-3.5 py-2 rounded-xl bg-base-300/50 hover:bg-base-300 border border-base-300/60 hover:border-white/10 text-xs font-mono text-base-content/90 transition-all group"
            >
              <span class="inline-flex items-center gap-2 truncate">
                <i class="ph ph-globe text-primary text-sm group-hover:rotate-12 transition-transform"></i>
                <span class="truncate">{{ friend.url | replace("https://", "") | replace("http://", "") | replace("www.", "") }}</span>
              </span>
              <i class="ph ph-arrow-up-right text-base-content/50 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all text-sm shrink-0"></i>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="card bg-base-200 card-border p-12 text-center rounded-2xl mb-16">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-base-300 text-primary mx-auto mb-4">
        <i class="ph ph-users text-2xl"></i>
      </div>
      <h3 class="text-lg font-headline font-bold mb-2">No friends listed yet</h3>
      <p class="text-sm text-base-content/60 max-w-md mx-auto">
        Check back soon or get in touch to be added to this webring.
      </p>
    </div>
  {% endif %}

  <!-- Connect / Webring Exchange Callout -->
  <div class="card bg-base-200 card-border p-8 rounded-2xl relative overflow-hidden">
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-primary/10 border border-primary/20 font-mono text-xs text-primary mb-3">
          <i class="ph ph-paper-plane-tilt"></i>
          <span>Open Web & IndieWeb</span>
        </div>
        <h3 class="text-2xl font-headline tracking-tight mb-2">
          {{ friends.connectTitle | default('Want to connect or exchange links?') }}
        </h3>
        <p class="text-sm text-base-content/70 leading-relaxed">
          {{ friends.connectDescription | default("If we've worked together or you run an independent corner of the web, shoot me an email and let's exchange links.") }}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        {% if site.email %}
          <a
            href="mailto:{{ site.email }}?subject=Link%20Exchange%20/%20Friends%20Directory"
            class="btn btn-primary btn-sm gap-2 font-mono text-xs rounded-xl shadow-xs"
          >
            <i class="ph ph-envelope-simple text-sm"></i>
            <span>Say Hello</span>
          </a>
        {% endif %}
        {% if site.github %}
          <a
            href="{{ site.github }}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost btn-sm gap-2 font-mono text-xs rounded-xl border border-base-300 hover:border-white/10"
          >
            <i class="ph ph-github-logo text-sm"></i>
            <span>GitHub</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

