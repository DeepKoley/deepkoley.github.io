---
layout: base.njk
title: "Friends & Blogroll — Deep Koley"
description: "A curated directory celebrating friends, collaborators, and independent creators across the open web."
permalink: "friends/index.html"
eleventyExcludeFromCollections: true

---

<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Breadcrumb -->
  {% set currentPage = "Friends" %}
  {% include "components/breadcrumbs.njk" %}

  <!-- Page Header -->
  <header class="mb-14">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs mb-3 shadow-xs">
      <i class="ph ph-users text-sm text-primary"></i>
      <span>{{ friends.pageBadge | default('Community & Webring') }}</span>
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4 leading-tight">
      {{ friends.pageTitle | default('Friends & Blogroll') }}
    </h1>
    <p class="text-lg text-base-content/70 leading-relaxed max-w-3xl">
      {{
        friends.pageDescription | default('A curated directory celebrating friends, collaborators, and independent creators across the open web.')
      }}
    </p>
  </header>

  <!-- Friends Directory Grid -->
  {% if friends.friends and friends.friends.length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for friend in friends.friends %}
        {% include "components/friend-card.njk" %}
      {% endfor %}
    </div>
  {% else %}
    <div class="card bg-base-200 card-border p-12 text-center rounded-2xl">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-base-300 text-primary mx-auto mb-4">
        <i class="ph ph-users text-2xl"></i>
      </div>
      <h3 class="text-lg font-headline font-bold mb-2">
        No friends listed yet
      </h3>
      <p class="text-sm text-base-content/60 max-w-md mx-auto">
        Check back soon to explore creators in this directory.
      </p>
    </div>
  {% endif %}
</div>
