---
layout: base.njk
title: "About — Deep Koley"
description: "Learn more about Deep Koley, engineering philosophy, background, and approach to crafting modern software."
eleventyExcludeFromCollections: true
---

<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-16">
  <!-- Breadcrumb -->
  <div class="breadcrumbs text-sm mb-6 text-base-content/60">
    <ul>
      <li><a href="/">Home</a></li>
      <li class="text-base-content">About</li>
    </ul>
  </div>

  <!-- Page Header -->
  <header class="mb-14">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-200 border border-base-300 font-mono text-xs mb-3 shadow-xs">
      <i data-feather="user" class="w-3.5 h-3.5 text-primary"></i>
      <span>{{ about.pageBadge | default('about.me') }}</span>
    </div>
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-headline tracking-tight mb-4 leading-tight">
      {{ about.pageTitle | default('Engineering Resilient Systems & Expressive Interfaces') }}
    </h1>
    <p class="text-lg text-base-content/70 leading-relaxed max-w-3xl">
      {{ about.pageDescription | default('A comprehensive look into my journey, core technical convictions, and the craft behind building modern digital experiences.') }}
    </p>
  </header>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
    <!-- Left Column: Profile Card & Quick Info (4 cols) -->
    <div class="lg:col-span-4 space-y-6">
      <div class="card bg-base-200 card-border shadow-xl overflow-hidden">
        <div class="p-6 text-center border-b border-base-300 flex flex-col items-center">
          <div class="avatar mb-4">
            <div class="w-32 rounded-full ring-2 ring-primary/40 ring-offset-base-100 ring-offset-4 shadow-xl">
              <img
                src="{{ home.heroAvatar | default('https://picsum.photos/seed/deepkoley/400/400') }}"
                alt="{{ site.name }}"
              />
            </div>
          </div>
          <h2 class="text-2xl font-headline">{{ site.name }}</h2>
          <p class="text-sm font-mono text-primary font-medium mt-1">
            {{ site.title }}
          </p>
          <div class="flex items-center gap-2 mt-3 px-3 py-1 rounded-full bg-base-300/60 font-mono text-xs">
            <span class="status status-success status-xs"></span>
            <span class="text-base-content/80">{{ site.status }}</span>
          </div>
        </div>

        <div class="p-6 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between py-1 border-b border-base-300/50">
            <span class="text-base-content/60">Location</span>
            <span class="font-medium text-base-content">{{ site.location }}</span>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-base-300/50">
            <span class="text-base-content/60">Experience</span>
            <span class="font-medium text-base-content">{{ about.experienceYears | default('5+ Years') }}</span>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-base-300/50">
            <span class="text-base-content/60">Core Focus</span>
            <span class="font-medium text-base-content text-right">{{ about.coreFocus | default('Web Architectures & UI') }}</span>
          </div>
          <div class="flex items-center justify-between py-1">
            <span class="text-base-content/60">Email</span>
            <a href="mailto:{{ site.email }}" class="link link-primary">{{ site.email }}</a>
          </div>
        </div>

        <div class="p-6 pt-0">
          <a href="/resume/" class="btn btn-primary btn-sm w-full font-mono">
            <i data-feather="file-text" class="w-3.5 h-3.5"></i>
            View Resume
          </a>
        </div>
      </div>

      <!-- Quick Principles -->
      <div class="card bg-base-200 card-border p-6 shadow-md">
        <h3 class="text-lg font-headline mb-4 flex items-center gap-2">
          <i data-feather="compass" class="w-4 h-4 text-secondary"></i>
          Guiding Principles
        </h3>
        <ul class="space-y-3 text-sm text-base-content/75">
          {% for p in about.principles %}
            <li class="flex items-start gap-2">
              <i data-feather="check-circle" class="w-4 h-4 text-primary shrink-0 mt-0.5"></i>
              <span><strong>{{ p.title }}:</strong> {{ p.description }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <!-- Right Column: Biography & Technical Depth (8 cols) -->
    <div class="lg:col-span-8 space-y-8">
      <!-- Story -->
      <section class="card bg-base-200 card-border p-6 sm:p-8 shadow-md">
        <h2 class="text-2xl sm:text-3xl font-headline mb-4 text-base-content">
          Background &amp; Story
        </h2>
        <div class="space-y-4 text-base text-base-content/80 leading-relaxed">
          {% for para in about.storyParagraphs %}
            <p>{{ para }}</p>
          {% endfor %}
        </div>
      </section>

      <!-- Technical Skills Breakdown -->
      <section class="card bg-base-200 card-border p-6 sm:p-8 shadow-md">
        <h2 class="text-2xl sm:text-3xl font-headline mb-6 text-base-content">
          Technical Toolkit
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {% for tool in about.toolkit %}
            <div class="p-4 rounded-xl bg-base-100 border border-base-300">
              <div class="flex items-center gap-2 mb-2 text-{{ tool.badgeColor | default('primary') }} font-mono text-xs uppercase tracking-wider font-semibold">
                <i data-feather="{{ tool.icon | default('layout') }}" class="w-4 h-4"></i>
                {{ tool.category }}
              </div>
              <p class="text-sm text-base-content/70 mb-3">
                {{ tool.description }}
              </p>
              <div class="flex flex-wrap gap-1.5">
                {% for skill in tool.skills %}
                  <span class="badge badge-neutral font-mono text-xs border border-base-300/60">{{ skill }}</span>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      </section>

      <!-- What I'm Doing Now -->
      <section class="card bg-base-200 card-border p-6 sm:p-8 shadow-md">
        <h2 class="text-2xl sm:text-3xl font-headline mb-4 text-base-content">
          Current Focus
        </h2>
        <ul class="space-y-3 font-mono text-sm text-base-content/80">
          {% for item in about.currentFocus %}
            <li class="flex items-center gap-2">
              <span class="status status-{{ item.status | default('success') }} status-xs"></span>
              {{ item.text }}
            </li>
          {% endfor %}
        </ul>
      </section>
    </div>
  </div>
</div>
