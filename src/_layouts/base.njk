<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <script>
    document.documentElement.setAttribute("data-theme", "dark");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="{{ description | default(site.description) }}"
    />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="{{ title | default(site.name ~ ' — ' ~ site.title) }}"
    />
    <meta
      property="og:description"
      content="{{ description | default(site.description) }}"
    />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta
      property="og:image"
      content="{{ home.heroAvatar | default(site.url ~ '/assets/img/og-preview.png') }}"
    />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content="{{ title | default(site.name ~ ' — ' ~ site.title) }}"
    />
    <meta
      name="twitter:description"
      content="{{ description | default(site.description) }}"
    />
    <meta
      name="twitter:image"
      content="{{ home.heroAvatar | default(site.url ~ '/assets/img/og-preview.png') }}"
    />
    <!-- Canonical -->
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
    <title>
      {{ title | default(site.name ~ ' — ' ~ site.title) }}{%
        if pagination.pageNumber > 0
      %}
        — Page {{ pagination.pageNumber + 1 }}{% endif %}
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=tanker@400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=nunito@400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/phosphor/regular/style.css" />
    <link rel="stylesheet" href="/css/phosphor/bold/style.css" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content transition-colors duration-200">
    {% include "components/navbar.njk" %}

    <!-- Page Content -->
    <main class="flex-1">
      {{ content | safe }}
    </main>

    {% include "components/footer.njk" %}

    <script src="/js/typed.umd.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
