<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <script>
    document.documentElement.setAttribute("data-theme", "dark");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="{{ description | default(site.description) }}"
    />
    <title>
      {{ title | default(site.name ~ ' — ' ~ site.title) }}{% if pagination.pageNumber > 0 %}
        — Page {{ pagination.pageNumber + 1 }}{% endif %}
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=tanker@400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=nunito@400&f[]=bebas-neue@400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/phosphor/regular/style.css" />
    <link rel="stylesheet" href="/css/phosphor/bold/style.css" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="min-h-screen flex flex-col bg-base-100 text-base-content transition-colors duration-200">
    <!-- Navbar (Constrained to max-w-6xl) -->
    <header class="bg-base-200/90 backdrop-blur-md sticky top-0 z-100 border-b border-base-300 shadow-xs">
      <div class="navbar max-w-6xl mx-auto px-4 sm:px-6">
        <div class="navbar-start">
          <div class="dropdown">
            <div
              tabindex="0"
              role="button"
              class="btn btn-ghost lg:hidden"
              aria-label="Toggle Navigation"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"
                />
              </svg>
            </div>
            <ul
              tabindex="0"
              class="menu menu-sm dropdown-content bg-base-200 rounded-box z-50 mt-3 w-52 p-2 shadow-lg border border-base-300"
            >
              <li><a href="/">Home</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/projects/">Projects</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/gallery/">Gallery</a></li>
              <li><a href="/friends/">Friends</a></li>
              <li><a href="/resume/">Resume</a></li>
            </ul>
          </div>
          <a href="/" class="btn btn-ghost text-xl font-bold tracking-tight">
            {{ site.firstName }} <span class="text-primary">{{ site.lastName }}</span>
          </a>
        </div>
        <div class="navbar-end hidden lg:flex">
          <ul class="menu menu-horizontal px-1 gap-1">
            <li><a href="/">Home</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/projects/">Projects</a></li>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/gallery/">Gallery</a></li>
            <li><a href="/friends/">Friends</a></li>
            <li><a href="/resume/">Resume</a></li>
          </ul>
        </div>
      </div>
    </header>

    <!-- Page Content -->
    <main class="flex-1">
      {{ content | safe }}
    </main>

    <!-- Footer (Constrained to max-w-6xl) -->
    <footer class="relative z-60 bg-base-200 text-base-content border-t border-base-300">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 flex flex-col items-center gap-6">
        <nav class="flex flex-wrap justify-center gap-6 text-sm">
          <a href="/" class="link link-hover">Home</a>
          <a href="/about/" class="link link-hover">About</a>
          <a href="/projects/" class="link link-hover">Projects</a>
          <a href="/blog/" class="link link-hover">Blog</a>
          <a href="/gallery/" class="link link-hover">Gallery</a>
          <a href="/friends/" class="link link-hover">Friends</a>
          <a href="/resume/" class="link link-hover">Resume</a>
        </nav>
        <nav>
          <div class="grid grid-flow-col gap-4">
            <!-- GitHub -->
            <a
              href="{{ site.github }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="text-base-content/70 hover:text-primary transition-colors"
            >
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
            <!-- LinkedIn -->
            <a
              href="{{ site.linkedin }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="text-base-content/70 hover:text-primary transition-colors"
            >
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
            <!-- Twitter/X -->
            <a
              href="{{ site.twitter }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Twitter"
              class="text-base-content/70 hover:text-primary transition-colors"
            >
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
              </svg>
            </a>
          </div>
        </nav>
        <aside class="text-center">
          <p class="text-xs text-base-content/60 font-mono">
            &copy; {{ site.name }}. Built with Eleventy &amp; daisyUI.
          </p>
        </aside>
      </div>
    </footer>

    <!-- Global Custom Alert / Toast Notification Container -->
    <div
      id="global-toast-container"
      class="toast toast-bottom toast-end z-999 pointer-events-none p-4 flex flex-col gap-2"
      aria-live="polite"
    >
    </div>

    <script src="/js/feather.min.js"></script>
    <script src="/js/typed.umd.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
