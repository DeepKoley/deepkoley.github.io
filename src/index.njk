  <div class="max-w-6xl mx-auto w-full px-4 sm:px-6">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-300/40 border border-base-300 font-mono text-xs mb-3 shadow-xs">
        <i data-feather="cpu" class="w-3.5 h-3.5 text-primary"></i>
        <span id="typed-skills-header"></span>
      </div>
      <h2 class="text-3xl sm:text-4xl">Skills &amp; Technologies</h2>
      <p class="mt-2 text-base-content/60 max-w-2xl mx-auto text-sm sm:text-base">
        A curated set of tools I use to build modern, scalable applications.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="card bg-base-200 card-border hover:-translate-y-1 transition-transform duration-300">
        <div class="card-body">
          <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-2">
            <i data-feather="layout" class="w-6 h-6"></i>
          </div>
          <h3 class="card-title">Frontend</h3>
          <p class="text-base-content/60 text-sm mb-4">
            Building interactive, accessible interfaces.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="badge badge-soft badge-primary">HTML</span>
            <span class="badge badge-soft badge-primary">CSS</span>
            <span class="badge badge-soft badge-primary">JavaScript</span>
            <span class="badge badge-soft badge-primary">React</span>
            <span class="badge badge-soft badge-primary">Tailwind CSS</span>
          </div>
        </div>
      </div>

      <div class="card bg-base-200 card-border hover:-translate-y-1 transition-transform duration-300">
        <div class="card-body">
          <div class="w-12 h-12 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center mb-2">
            <i data-feather="server" class="w-6 h-6"></i>
          </div>
          <h3 class="card-title">Backend</h3>
          <p class="text-base-content/60 text-sm mb-4">
            Designing reliable APIs and server-side logic.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="badge badge-soft badge-secondary">Node.js</span>
            <span class="badge badge-soft badge-secondary">Python</span>
            <span class="badge badge-soft badge-secondary">Express</span>
            <span class="badge badge-soft badge-secondary">REST APIs</span>
            <span class="badge badge-soft badge-secondary">GraphQL</span>
          </div>
        </div>
      </div>

      <div class="card bg-base-200 card-border hover:-translate-y-1 transition-transform duration-300">
        <div class="card-body">
          <div class="w-12 h-12 rounded-2xl bg-accent/10 text-accent flex items-center justify-center mb-2">
            <i data-feather="database" class="w-6 h-6"></i>
          </div>
          <h3 class="card-title">Database & Cloud</h3>
          <p class="text-base-content/60 text-sm mb-4">
            Managing data and deploying at scale.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="badge badge-soft badge-accent">PostgreSQL</span>
            <span class="badge badge-soft badge-accent">MongoDB</span>
            <span class="badge badge-soft badge-accent">Firebase</span>
            <span class="badge badge-soft badge-accent">Docker</span>
            <span class="badge badge-soft badge-accent">AWS</span>
