  <div class="max-w-6xl mx-auto w-full px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Info Column (5 cols) -->
      <div class="lg:col-span-5 text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-300/40 border border-base-300 font-mono text-xs mb-3 shadow-xs">
          <i data-feather="mail" class="w-3.5 h-3.5 text-primary"></i>
          <span id="typed-contact-header"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-headline mb-4 leading-tight">
          Let's Work Together
        </h2>
        <p class="text-base-content/70 mb-6 text-base leading-relaxed">
          Have an upcoming project, architecture challenge, or contract
          opportunity? My inbox is always open. Let's build something
          exceptional.
        </p>

        <div class="space-y-3 font-mono text-sm">
          <div class="flex items-center gap-3 p-3 rounded-xl bg-base-200/80 border border-base-300 shadow-xs">
            <i data-feather="mail" class="w-4 h-4 text-primary"></i>
            <a
              href="mailto:hello@deepkoley.dev"
              class="link link-hover text-base-content hover:text-primary"
            >hello@deepkoley.dev</a>
          </div>
          <div class="flex items-center gap-3 p-3 rounded-xl bg-base-200/80 border border-base-300 shadow-xs">
            <i data-feather="map-pin" class="w-4 h-4 text-primary"></i>
            <span class="text-base-content/80">Kolkata, India (UTC+5:30)</span>
          </div>
          <div class="flex items-center gap-3 p-3 rounded-xl bg-base-200/80 border border-base-300 shadow-xs">
            <span class="status status-success status-xs"></span>
            <span class="text-base-content/80"
            >Available for freelance &amp; contracts</span>
          </div>
        </div>
      </div>

      <!-- Right Form Column (7 cols) -->
      <div class="lg:col-span-7">
        <div class="card bg-base-200 card-border shadow-xl">
          <form
            id="contact-form"
            onsubmit="handleContactSubmit(event)"
            class="card-body gap-4 p-6 sm:p-8"
          >
            <div class="flex flex-col sm:flex-row gap-4">
              <input
                id="contact-name"
                name="name"
                type="text"
                placeholder="Your Name (e.g. Alex Rivera)"
                class="input input-bordered flex-1"
                required
              />
              <input
                id="contact-email"
                name="email"
                type="email"
                placeholder="Your Email (e.g. alex@company.com)"
                class="input input-bordered flex-1"
                required
              />
            </div>
            <textarea
              id="contact-message"
              name="message"
              class="textarea textarea-bordered h-36 resize-none"
              placeholder=""
              required
            ></textarea>
            <div class="card-actions justify-end">
              <button type="submit" class="btn btn-primary w-full sm:w-auto">
                Send Message
                <i data-feather="send" class="w-4 h-4"></i>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact Confirmation Modal Component (daisyUI modal dialog) -->
  <dialog id="contact_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box border border-base-300 bg-base-200 text-center p-8">
      <div class="w-16 h-16 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto mb-4">
        <i data-feather="check-circle" class="w-8 h-8"></i>
      </div>
      <h3 class="font-headline text-2xl mb-2 text-base-content">Message Sent!</h3>
      <p id="contact-modal-feedback" class="text-sm text-base-content/70 leading-relaxed mb-6 max-w-sm mx-auto">
        Thank you for reaching out. Your note has been received and I'll get back to you shortly.
      </p>
      <div class="modal-action justify-center">
        <form method="dialog">
          <button class="btn btn-primary font-mono px-8">Done</button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
</section>
