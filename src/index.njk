</section>

<!-- ═══════════════════════════════════════ PROJECTS ════════════════════════════════════ -->
<section
  id="projects"
  class="portfolio-section portfolio-section-3 py-16 sm:py-24"
>
  <div class="max-w-6xl mx-auto w-full px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-300/40 border border-base-300 font-mono text-xs mb-2 shadow-xs">
          <i data-feather="layers" class="w-3.5 h-3.5 text-secondary"></i>
          <span id="typed-projects-header"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-headline">Featured Projects</h2>
        <p class="mt-1 text-base-content/60 max-w-2xl text-sm sm:text-base">
          Case studies highlighting architectural choices, performance wins, and
          interfaces.
        </p>
      </div>
      <a
        href="/projects/"
        class="btn btn-outline btn-sm font-mono self-start md:self-auto"
      >
        View All Projects ({{ collections.projects | length }})
        <i data-feather="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for project in collections.projects | limit(3) %}
        <article class="card bg-base-100 card-border overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div>
            <a
              href="{{ project.url }}"
              class="block overflow-hidden aspect-video bg-base-300 relative group"
            >
              <img
                src="{{ project.data.image }}"
                alt="{{ project.data.title }}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              {% if project.data.status %}
                <span
                  class="absolute top-3 right-3 badge badge-success badge-soft font-mono text-xs shadow-xs"
                >
                  {{ project.data.status }}
                </span>
              {% endif %}
            </a>
            <div class="card-body p-6">
              <div class="flex items-center gap-2 mb-1.5">
                <span
                  class="text-xs font-mono text-primary font-semibold uppercase tracking-wider"
                >
                  {{ project.data.category | default('Full-Stack') }}
                </span>
              </div>
              <h3 class="card-title text-xl font-headline hover:text-primary transition-colors">
                <a href="{{ project.url }}">{{ project.data.title }}</a>
              </h3>
              <p class="text-base-content/70 text-sm leading-relaxed mt-2 mb-4 line-clamp-2">
                {{ project.data.description }}
              </p>
              <div class="flex flex-wrap gap-1">
                {% for tag in project.data.tags %}
                  {% if tag != "projects" %}
                    <span class="badge badge-neutral badge-xs font-mono">{{
                      tag
                    }}</span>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="px-6 pb-6 pt-0 border-t border-base-200 mt-2 flex items-center justify-between">
            <a
              href="{{ project.url }}"
              class="link link-primary text-sm font-mono inline-flex items-center gap-1 pt-3"
            >
              Case Study
              <i data-feather="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════ BLOG ═══════════════════════════════════════ -->
<section id="blog" class="portfolio-section portfolio-section-4 py-16 sm:py-24">
  <div class="max-w-6xl mx-auto w-full px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-base-300/40 border border-base-300 font-mono text-xs mb-2 shadow-xs">
          <i data-feather="book-open" class="w-3.5 h-3.5 text-primary"></i>
          <span id="typed-blog-header"></span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-headline">
          Latest Articles &amp; Insights
        </h2>
        <p class="mt-1 text-base-content/60 max-w-2xl text-sm sm:text-base">
          Deep dives into software architecture, frontend performance, and UI
          design.
        </p>
      </div>
      <a
        href="/blog/"
        class="btn btn-outline btn-sm font-mono self-start md:self-auto"
      >
        Read All Articles ({{ collections.posts | length }})
        <i data-feather="arrow-right" class="w-3.5 h-3.5"></i>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for post in collections.posts | limit(3) %}
        <article class="card bg-base-200 card-border overflow-hidden hover:-translate-y-1 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
          <div>
            <a
              href="{{ post.url }}"
              class="block overflow-hidden aspect-video bg-base-300 relative group"
            >
              <img
                src="{{ post.data.image }}"
                alt="{{ post.data.title }}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </a>
            <div class="card-body p-6">
              <div class="flex items-center gap-2 mb-2 text-xs font-mono text-base-content/60">
                <time datetime="{{ post.date }}">{{
                  post.date | readableDate
                }}</time>
                {% if post.data.readTime %}
                  <span>• {{ post.data.readTime }}</span>
                {% endif %}
              </div>
              <h3 class="card-title text-xl font-headline hover:text-primary transition-colors leading-snug">
                <a href="{{ post.url }}">{{ post.data.title }}</a>
              </h3>
              <p class="text-base-content/70 text-sm leading-relaxed mt-2 mb-4 line-clamp-2">
                {{ post.data.description }}
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-0 border-t border-base-300/40 mt-2 flex items-center justify-between">
            <a
              href="{{ post.url }}"
              class="link link-primary text-sm font-mono inline-flex items-center gap-1.5 pt-3"
            >
              Read Article
              <i data-feather="arrow-right" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

